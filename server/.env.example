PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collab-docs
# If you get "querySrv ECONNREFUSED" on startup, your network/router/VPN is
# blocking DNS SRV lookups. Fix: in the Atlas dashboard, under Database >
# Connect > Drivers, switch the connection string format from "mongodb+srv"
# to the plain "mongodb://" / "Standard connection string" option (lists
# each shard host explicitly) and use that instead.
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
SEED_PASSWORD=password123
